# =============================================================================
# Woodpecker CI — Environment Variables
# Copy to .env.ci and fill in values, then:
#   cp .env.ci .env && docker compose -f docker-compose.ci.yml up -d
# =============================================================================

VPS_IP=72.62.182.196

# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Your GitHub username (will be admin in Woodpecker)
WOODPECKER_ADMIN=your-github-username

# ── GitHub OAuth App credentials ──
WOODPECKER_GITHUB_CLIENT=your-github-oauth-client-id
WOODPECKER_GITHUB_SECRET=your-github-oauth-client-secret
